{
  "name": "@williamvux/service-core",
  "version": "0.1.0",
  "description": "Shared building blocks for the Express + TypeScript backends: decorators, responses, errors, DI, middleware",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamvux/service-core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.mjs'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.mjs'",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "pack:check": "node scripts/pack-check.mjs",
    "verify": "yarn typecheck && yarn lint && yarn format:check && yarn test && yarn build && yarn pack:check",
    "prepack": "yarn build",
    "prepare": "yarn build"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "knex": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "knex": "^3.3.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
